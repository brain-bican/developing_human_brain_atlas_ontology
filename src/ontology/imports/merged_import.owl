AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "BIRNLEX:2564") <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0002827> "UMLS:C0037959")
