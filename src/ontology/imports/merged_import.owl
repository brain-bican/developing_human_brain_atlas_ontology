AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "BTO:0001102") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Wikipedia:Blood_vessel") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0001981> "A vessel through which blood circulates in the body.")
