# Class: <http://purl.obolibrary.org/obo/UBERON_0002407> (pericardium)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Wikipedia:Pericardium") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://orcid.org/0000-0002-6601-2165") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0002407> "The combination of pericardial sac (a double-walled sac containing the heart and the roots of the great vessels) plus fibrous pericardium.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#date_retrieved> "2012-06-20") Annotation(<http://www.geneontology.org/formats/oboInOwl#external_class> "AAO:0010817") Annotation(<http://www.geneontology.org/formats/oboInOwl#ontology> "AAO") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "AAO:JMG") <http://purl.obolibrary.org/obo/UBPROP_0000001> <http://purl.obolibrary.org/obo/UBERON_0002407> "Peritoneum that surrounds the heart.[AAO]")
AnnotationAssertion(<http://purl.obolibrary.org/obo/UBPROP_0000007> <http://purl.obolibrary.org/obo/UBERON_0002407> "pericardial")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#external_ontology> "FMA") <http://purl.obolibrary.org/obo/UBPROP_0000012> <http://purl.obolibrary.org/obo/UBERON_0002407> "In GO the concept of pericardium is developmental implicitly epithelial, but here it represents a multi-tissue structure encompassing the sac (epithelium plus connective) and cavity")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#external_ontology> "ZFA") <http://purl.obolibrary.org/obo/UBPROP_0000012> <http://purl.obolibrary.org/obo/UBERON_0002407> "this class denotes a combination of fibrous PC + PC sac (itself a combination of cavity, epithelium and connective tissue). Many sources use the term 'pericardium' to denote either just the serous membrane (ZFA) or the epithelium (GO)")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#external_ontology> "FMA") <http://purl.obolibrary.org/obo/UBPROP_0000012> <http://purl.obolibrary.org/obo/UBERON_0002407> "we follow FMA in dividing pericardium into pericardial sac and fibrous pericardium")
