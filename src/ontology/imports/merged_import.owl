AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "ncithesaurus:Epiblast") <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0008780> "UMLS:C1516906")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "MP:0003886") <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/UBERON_0008780> "embryonic epiblast")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/UBERON_0008780> "UBERON:0008780")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/UBERON_0008780> <http://purl.obolibrary.org/obo/uberon/core#early_development>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/UBERON_0008780> <http://purl.obolibrary.org/obo/uberon/core#pheno_slim>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/UBERON_0008780> "The epiblast cells (appearing on day 8 of human embryonic development) make up a columnar epithelium with dense microvilli on the apical surface. During gastrulation, the epiblast cells undergo epithelial-to-mesenchymal transition and delaminate to become the loose mesenchyme of the primitive streak. The epiblast is present in postimplantation mouse embryos between E5.5-E7.5.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UBERON_0008780> "inner cell mass derived epiblast")
EquivalentClasses(<http://purl.obolibrary.org/obo/UBERON_0008780> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/UBERON_0002532> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002202> <http://purl.obolibrary.org/obo/UBERON_0000087>)))
