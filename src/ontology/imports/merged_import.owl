AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Wikipedia:Lateral_rectus_muscle") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0001603> "The lateral rectus muscle is a muscle in the orbit. It is one of six extraocular muscles that control the movements of the eye (abduction in this case) and the only muscle innervated by the abducens nerve, cranial nerve VI. [WP,unvetted].")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#date_retrieved> "2012-06-20") Annotation(<http://www.geneontology.org/formats/oboInOwl#external_class> "AAO:0010107") Annotation(<http://www.geneontology.org/formats/oboInOwl#ontology> "AAO") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "AAO:EJS") <http://purl.obolibrary.org/obo/UBPROP_0000001> <http://purl.obolibrary.org/obo/UBERON_0001603> "Cranial nerve VI innervated; lateral in the rectus group.[AAO]")
