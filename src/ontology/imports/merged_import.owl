# Class: <http://purl.obolibrary.org/obo/UBERON_0003104> (mesenchyme)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://archive.org/details/invertebratesnde00brus/page/n240/mode/2up") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Mesenchyme") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://github.com/obophenotype/uberon/issues/1641") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0003104> "Portion of tissue composed of mesenchymal cells (motile cells that develop from epthelia via an epithelial to mesenchymal transition) and surrounding extracellular material. Mesenchyme has different embryological origins in different metazoan taxa - in many invertebrates it derives in whole or part from ectoderm. In vertebrates it derives largely from mesoderm, and sometimes the terms are used interchangeably, e.g. lateral plate mesoderm/mesenchyme.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000116> <http://purl.obolibrary.org/obo/UBERON_0003104> "the relationship to mesoderm is weaker than develops_from in order to have classes such as 'head mesenchyme from mesoderm' make sense")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#date_retrieved> "2012-08-14") Annotation(<http://www.geneontology.org/formats/oboInOwl#external_class> "TAO:0000393") Annotation(<http://www.geneontology.org/formats/oboInOwl#ontology> "TAO") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "ZFIN:curator") <http://purl.obolibrary.org/obo/UBPROP_0000001> <http://purl.obolibrary.org/obo/UBERON_0003104> "A mesh-like cell arrangement, less compact than an epithelium. Kimmel et al, 1995.[TAO]")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#date_retrieved> "2012-06-20") Annotation(<http://www.geneontology.org/formats/oboInOwl#external_class> "AAO:0010427") Annotation(<http://www.geneontology.org/formats/oboInOwl#ontology> "AAO") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "AAO:EJS") <http://purl.obolibrary.org/obo/UBPROP_0000001> <http://purl.obolibrary.org/obo/UBERON_0003104> "Portion of tissue consisting of loosely organized undifferentiated mesodermal cells that give rise to such structures as connective tissues, blood, lymphatics, bone, and cartilage.[AAO]")
AnnotationAssertion(<http://purl.obolibrary.org/obo/UBPROP_0000007> <http://purl.obolibrary.org/obo/UBERON_0003104> "mesenchymal")
