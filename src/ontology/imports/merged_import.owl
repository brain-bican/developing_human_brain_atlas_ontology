AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "VHOG:0000676") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/OMO_0003004>) <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/UBERON_0004290> "dermomyotomes")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/UBERON_0004290> "UBERON:0004290")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UBERON_0004290> "dermomyotome")
SubClassOf(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "AEO") <http://purl.obolibrary.org/obo/UBERON_0004290> <http://purl.obolibrary.org/obo/UBERON_0000486>)
SubClassOf(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "AEO") <http://purl.obolibrary.org/obo/UBERON_0004290> <http://purl.obolibrary.org/obo/UBERON_0016888>)
