AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "MP:000999") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:1953602") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "UBERON:cjm") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0035922> "A fissure that divides the culmen lobule (lobules IV and V).")
