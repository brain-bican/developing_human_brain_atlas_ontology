AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "MP:0009984") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0004073> "The nucleus composed of the globose and emoliform nuclei of the cerebellum; in some mammalian species the globose nucleus is not distinguishable.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "ISBN:0471888893") <http://purl.obolibrary.org/obo/RO_0002161> <http://purl.obolibrary.org/obo/UBERON_0004073> <http://purl.obolibrary.org/obo/NCBITaxon_8570>)
