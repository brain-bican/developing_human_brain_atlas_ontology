# Class: <http://purl.obolibrary.org/obo/UBERON_0007122> (pharyngeal pouch 1)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:0124020607") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:16313389") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "VHOG:0000970") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0007122> "A pharyngeal pouch that is between pharyngeal arches 1 and 2.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#date_retrieved> "2012-09-17") Annotation(<http://www.geneontology.org/formats/oboInOwl#external_class> "VHOG:0000970") Annotation(<http://www.geneontology.org/formats/oboInOwl#ontology> "VHOG") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "http://bgee.unil.ch/") <http://purl.obolibrary.org/obo/UBPROP_0000001> <http://purl.obolibrary.org/obo/UBERON_0007122> ". [][VHOG]")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#date_retrieved> "2012-09-17") Annotation(<http://www.geneontology.org/formats/oboInOwl#external_class> "VHOG:0000970") Annotation(<http://www.geneontology.org/formats/oboInOwl#ontology> "VHOG") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "DOI:10.1016/j.semcdb.2010.01.022 Grevellec A, Tucker AS, The pharyngeal pouches and clefts: development, evolution, structure and derivatives. Seminars in Cell and Developmental Biology (2010)") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "http://bgee.unil.ch/") <http://purl.obolibrary.org/obo/UBPROP_0000003> <http://purl.obolibrary.org/obo/UBERON_0007122> "In all jawed vertebrates the first arch forms the jaw, while the second arch forms the hyoid apparatus. These two arches are separated by the first pharyngeal pouch and cleft.[well established][VHOG]")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "WP") <http://purl.obolibrary.org/obo/UBPROP_0000011> <http://purl.obolibrary.org/obo/UBERON_0007122> "The endoderm lines the future auditory tube (Pharyngotympanic Eustachian tube) , middle ear, mastoid antrum, and inner layer of the tympanic membrane. & origin of Mandibular nerve & Maxillary artery")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#external_ontology> "EHDAA2") <http://purl.obolibrary.org/obo/UBPROP_0000012> <http://purl.obolibrary.org/obo/UBERON_0007122> "we use adjacency relations rather than part_of, as in EHDAA2.")
