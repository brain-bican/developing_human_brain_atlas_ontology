SubClassOf(Annotation(<http://www.geneontology.org/formats/oboInOwl#notes> "we limit this structure by definition to chordate and vertebrate nervous systems") <http://purl.obolibrary.org/obo/UBERON_0000125> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002162> <http://purl.obolibrary.org/obo/NCBITaxon_7711>))
