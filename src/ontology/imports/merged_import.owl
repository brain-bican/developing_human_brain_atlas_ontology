# Object Property: <http://purl.obolibrary.org/obo/uberon/core#filtered_through> (filtered through)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/uberon/core#filtered_through> "Relationship between a fluid and a material entity, where the fluid is the output of a realization of a filtration role that inheres in the material entity.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/uberon/core#filtered_through> "filtered_through")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/uberon/core#filtered_through> "Relationship between a fluid and a filtration barrier, where the portion of fluid arises as a transformation of another portion of fluid on the other side of the barrier, with larger particles removed")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/uberon/core#filtered_through> "filtered through")

# Object Property: <http://purl.obolibrary.org/obo/uberon/core#indirectly_supplies> (indirectly_supplies)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/uberon/core#indirectly_supplies> "a indirectly_supplies s iff a has a branch and the branch supplies or indirectly supplies s.")
