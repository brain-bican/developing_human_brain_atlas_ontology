# Class: <http://purl.obolibrary.org/obo/UBERON_0001601> (extra-ocular muscle)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GO:0002074") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Wikipedia:Extraocular_muscles") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0001601> "Skeletal muscle derived from cranial mesoderm and controls eye movements.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000116> <http://purl.obolibrary.org/obo/UBERON_0001601> "todo - resolve discrepancies in which muscles are considered extra-ocular")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#date_retrieved> "2012-09-17") Annotation(<http://www.geneontology.org/formats/oboInOwl#external_class> "VHOG:0000549") Annotation(<http://www.geneontology.org/formats/oboInOwl#ontology> "VHOG") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "http://bgee.unil.ch/") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "http://medical-dictionary.thefreedictionary.com/extraocular+muscle") <http://purl.obolibrary.org/obo/UBPROP_0000001> <http://purl.obolibrary.org/obo/UBERON_0001601> "Any of the six small muscles that control movement of the eyeball within the socket. [TFD][VHOG]")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#date_retrieved> "2012-06-20") Annotation(<http://www.geneontology.org/formats/oboInOwl#external_class> "AAO:0010028") Annotation(<http://www.geneontology.org/formats/oboInOwl#ontology> "AAO") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "AAO:EJS") <http://purl.obolibrary.org/obo/UBPROP_0000001> <http://purl.obolibrary.org/obo/UBERON_0001601> "Muscles surrounding the eye (bulbus oculi) and having an effect on eye movements.[AAO]")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#date_retrieved> "2012-09-17") Annotation(<http://www.geneontology.org/formats/oboInOwl#external_class> "VHOG:0000549") Annotation(<http://www.geneontology.org/formats/oboInOwl#ontology> "VHOG") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "ISBN:978-0030223693 Liem KF, Bemis WE, Walker WF, Grande L, Functional Anatomy of the Vertebrates: An Evolutionary Perspective (2001) p.331") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "http://bgee.unil.ch/") <http://purl.obolibrary.org/obo/UBPROP_0000003> <http://purl.obolibrary.org/obo/UBERON_0001601> "The ability to rotate the eyeball is common to all vertebrates with well-developed eyes, regardless of the habitat in which they live, so these (extrinsic ocular) muscles tend to be conservative. They change little during the course of evolution.[well established][VHOG]")
AnnotationAssertion(<http://purl.obolibrary.org/obo/UBPROP_0000007> <http://purl.obolibrary.org/obo/UBERON_0001601> "extraocular")
AnnotationAssertion(<http://purl.obolibrary.org/obo/UBPROP_0000008> <http://purl.obolibrary.org/obo/UBERON_0001601> "Mammals have 7 extra-ocular muscles, but humans lack the M. retractor bulbi.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/UBPROP_0000011> <http://purl.obolibrary.org/obo/UBERON_0001601> "Myofibers in extraocular muscles are derived from mesoderm, whereas muscle connective tissue cells arise from neural crest.[PMID:16638982]")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#external_ontology> "BTO") <http://purl.obolibrary.org/obo/UBPROP_0000012> <http://purl.obolibrary.org/obo/UBERON_0001601> "BTO and MA consider this part of the eye; we follow them here (inferred from skeletal muscle). Not clear if omission from FMA is deliberate.")
