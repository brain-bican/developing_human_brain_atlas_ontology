SubClassOf(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "EMAPA") <http://purl.obolibrary.org/obo/UBERON_0006283> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/UBERON_0005498>))
