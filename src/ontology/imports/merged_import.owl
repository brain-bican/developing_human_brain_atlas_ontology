AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "BIRNLEX:1001") <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0002549> "UMLS:C0175460")
