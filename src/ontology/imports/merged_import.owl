# Class: <http://purl.obolibrary.org/obo/UBERON_0002827> (vestibulocochlear ganglion)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "MGI:smb") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "MP:0003703") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0002827> "The group of neuron cell bodies associated with the eighth cranial nerve during embryogenesis; splits in later development to form the cochlear and vestibular ganglia.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000116> <http://purl.obolibrary.org/obo/UBERON_0002827> "Consider follow MA naming scheme.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#date_retrieved> "2012-08-14") Annotation(<http://www.geneontology.org/formats/oboInOwl#external_class> "TAO:0000588") Annotation(<http://www.geneontology.org/formats/oboInOwl#ontology> "TAO") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "ZFIN:curator") <http://purl.obolibrary.org/obo/UBPROP_0000001> <http://purl.obolibrary.org/obo/UBERON_0002827> "The sensory ganglion of the ear. (See Anatomical Atlas entry for statoacoustic ganglion by T. Whitfield.)[TAO]")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#date_retrieved> "2012-09-17") Annotation(<http://www.geneontology.org/formats/oboInOwl#external_class> "VHOG:0000696") Annotation(<http://www.geneontology.org/formats/oboInOwl#ontology> "VHOG") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "PMID:21452441 Park BY, Saint-Jeannet JP, Induction and Segregation of the Vertebrate Cranial Placodes. Developmental Biology (2010)") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "http://bgee.unil.ch/") <http://purl.obolibrary.org/obo/UBPROP_0000003> <http://purl.obolibrary.org/obo/UBERON_0002827> "(During the development of the inner ear in a vertebrate embryo) As the otic placode invaginates into a cup neuroblasts delaminate from the anterior ventral aspect of the otic epithelium to give rise to neurons of the vestibulocochlear (statoacoustic) ganglion of cranial nerve VIII.[well established][VHOG]")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "Wikipedia:Cochlear_nerve") <http://purl.obolibrary.org/obo/UBPROP_0000013> <http://purl.obolibrary.org/obo/UBERON_0002827> "The cell bodies of the cochlear nerve lie within the central aspect of the cochlea and are collectively known as the spiral ganglion. This name reflects the fact that the cell bodies, considered as a unit, have a spiral (or perhaps more accurately, a helical) shape, reflecting the shape of the cochlea. The terms 'cochlear nerve fiber' and 'spiral ganglion cell' are used, to some degree, interchangeably, although the former may be used to more specifically refer to the central axons of the cochlear nerve. These central axons exit the cochlea at its base, where it forms a nerve trunk. In humans, this aspect of the nerve is roughly one inch in length. It projects centrally to the brainstem, where its fibers synapse with the cell bodies of the cochlear nucleus")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ZFA:0000588") <http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> <http://purl.obolibrary.org/obo/UBERON_0002827> "SAG")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0002827> "BIRNLEX:2564")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0002827> "EFO:0003543")
