# Class: <http://purl.obolibrary.org/obo/UBERON_0001944> (pretectal region)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:0471888893") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://github.com/obophenotype/uberon/issues/361") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0001944> "Nuclear complex between dorsal thalamus and optic tectum whose nuclei receive afferents primarily from the retina and the optic tectum and are involved in modulating motor behavior in response to visual input.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "ABA") <http://purl.obolibrary.org/obo/RO_0002171> <http://purl.obolibrary.org/obo/UBERON_0001944> <http://purl.obolibrary.org/obo/UBERON_0001715>)
