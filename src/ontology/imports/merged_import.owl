# Class: <http://purl.obolibrary.org/obo/UBERON_0010499> (pseudostratified ciliated columnar epithelium)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "NCIT:NCIT") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0010499> "Epithelium composed of a single layer of cells, appearing as layered because the column-shaped cells vary in height so the nuclei are at different levels. The basal portions of all the cells are in contact with the basement membrane. It lines the respiratory system and the male reproductive tract. The cilia in the respiratory tract are motile, while the stereocilia in the male reproductive tract are immobile.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0010499> "FMA:13146")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0010499> "NCIT:C13181")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "ncithesaurus:Pseudostratified_Columnar_Ciliated_Epithelium") <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0010499> "UMLS:C0506992")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FMA:13146") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/UBERON_0010499> "epithelium pseudostratificatum columnare ciliatum (trachea et bronchi)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/UBERON_0010499> "UBERON:0010499")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UBERON_0010499> "pseudostratified ciliated columnar epithelium")
EquivalentClasses(<http://purl.obolibrary.org/obo/UBERON_0010499> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/UBERON_0010498> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> <http://purl.obolibrary.org/obo/CL_0000067>)))
