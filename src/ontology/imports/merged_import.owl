# Class: <http://purl.obolibrary.org/obo/UBERON_0002241> (chondrocranium)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Wikipedia:Chondrocranium") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://medical-dictionary.thefreedictionary.com/chondrocranium") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0002241> "Endoskeletal elements that encase the brain, nose, inner ear[cjm]. that part of the neurocranium formed by endochondral ossification and comprising the bones of the base of the skull[TFD].")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000116> <http://purl.obolibrary.org/obo/UBERON_0002241> "we follow the standard evolutionary classification and treat this as endoskeletal. This means what MA calls 'chondrocranium' must in fact be neurocranium, as it includes parts of the dermatocranium (e.g. frontal, parietal)")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#date_retrieved> "2012-06-20") Annotation(<http://www.geneontology.org/formats/oboInOwl#external_class> "AAO:0010169") Annotation(<http://www.geneontology.org/formats/oboInOwl#ontology> "AAO") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "AAO:BJB") <http://purl.obolibrary.org/obo/UBPROP_0000001> <http://purl.obolibrary.org/obo/UBERON_0002241> "Anatomical cluster that is part of the cranium and composed of cartilage and cartilage replacement bones.[AAO]")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#date_retrieved> "2012-08-14") Annotation(<http://www.geneontology.org/formats/oboInOwl#external_class> "TAO:0001424") Annotation(<http://www.geneontology.org/formats/oboInOwl#ontology> "TAO") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "ZFIN:curator") <http://purl.obolibrary.org/obo/UBPROP_0000001> <http://purl.obolibrary.org/obo/UBERON_0002241> "Anatomical cluster that is part of the cranium and composed of cartilage and cartilage replacement bones.[TAO]")
AnnotationAssertion(<http://purl.obolibrary.org/obo/UBPROP_0000007> <http://purl.obolibrary.org/obo/UBERON_0002241> "chondrocranial")
