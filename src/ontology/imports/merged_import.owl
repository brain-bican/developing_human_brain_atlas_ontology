# Class: <http://purl.obolibrary.org/obo/UBERON_0002265> (olfactory tract)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "BIRNLEX:1663") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:0471888893") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Wikipedia:Olfactory_tract") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://orcid.org/0000-0002-6601-2165") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0002265> "White matter tract that contains projections from the olfactory bulb to other parts of the brain.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "BTO:0003647") <http://purl.obolibrary.org/obo/UBPROP_0000001> <http://purl.obolibrary.org/obo/UBERON_0002265> "A nervelike, white band composed primarily of nerve fibres originating from the mitral cells and tufted cells of the olfactory bulb but also containing the scattered cells of the anterior olfactory nucleus[BTO:0003647].")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "Wikipedia:Olfactory_tract") <http://purl.obolibrary.org/obo/UBPROP_0000001> <http://purl.obolibrary.org/obo/UBERON_0002265> "The olfactory tract is a bundle of axons connecting the mitral and tufted cells of the olfactory bulb to several target regions in the brain, including piriform cortex, amygdala, and entorhinal cortex. It is a narrow white band, triangular on coronal section, the apex being directed upward. It lies in the olfactory sulcus on the inferior surface of the frontal lobe, and divides posteriorly into two striæ, a medial olfactory stria and a lateral olfactory stria.[Wikipedia].")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "FMA") <http://purl.obolibrary.org/obo/UBPROP_0000001> <http://purl.obolibrary.org/obo/UBERON_0002265> "Tract of brain which is continuous with olfactory bulb and the cerebral cortex.[FMA]")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#notes> "deprecated class") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "BIRNLEX:1663") <http://purl.obolibrary.org/obo/UBPROP_0000001> <http://purl.obolibrary.org/obo/UBERON_0002265> "White matter tract that contains projections from the olfactory bulb to the olfactory cortex (Maryann Martone)")
AnnotationAssertion(<http://purl.obolibrary.org/obo/UBPROP_0000008> <http://purl.obolibrary.org/obo/UBERON_0002265> "in animals with a long snout, the olfactory tract is long, whereas it is short in short-snouted animals such as primates. In some birds the tract per se does not exist as the bulb is connected directly to the cerebral hemisphere.[ISBN:0471888893]")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#editor> "cjm") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "ISBN:0471888893") <http://purl.obolibrary.org/obo/UBPROP_0000012> <http://purl.obolibrary.org/obo/UBERON_0002265> "The definition was adapted from the NIFSTD class which has been retired. It has been generalized so it is applicable to various different kinds of olfactory tracts found in different taxa.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0002265> "BAMS:olf")
