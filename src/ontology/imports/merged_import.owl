AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FMA:52740") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FMA:TA") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Wikipedia:Ethmoid") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/OMO_0003011>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/UBERON_0001679> "os ethmoidale")
