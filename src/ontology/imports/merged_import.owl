AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "ABA") <http://purl.obolibrary.org/obo/RO_0002171> <http://purl.obolibrary.org/obo/UBERON_0001944> <http://purl.obolibrary.org/obo/UBERON_0001966>)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "ABA") <http://purl.obolibrary.org/obo/RO_0002171> <http://purl.obolibrary.org/obo/UBERON_0001944> <http://purl.obolibrary.org/obo/UBERON_0002141>)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "ABA") <http://purl.obolibrary.org/obo/RO_0002171> <http://purl.obolibrary.org/obo/UBERON_0001944> <http://purl.obolibrary.org/obo/UBERON_0002438>)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "ABA") <http://purl.obolibrary.org/obo/RO_0002171> <http://purl.obolibrary.org/obo/UBERON_0001944> <http://purl.obolibrary.org/obo/UBERON_0002691>)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "ABA") <http://purl.obolibrary.org/obo/RO_0002171> <http://purl.obolibrary.org/obo/UBERON_0001944> <http://purl.obolibrary.org/obo/UBERON_0002696>)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "ABA") <http://purl.obolibrary.org/obo/RO_0002171> <http://purl.obolibrary.org/obo/UBERON_0001944> <http://purl.obolibrary.org/obo/UBERON_0002722>)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "ABA") <http://purl.obolibrary.org/obo/RO_0002171> <http://purl.obolibrary.org/obo/UBERON_0001944> <http://purl.obolibrary.org/obo/UBERON_0002995>)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "ABA") <http://purl.obolibrary.org/obo/RO_0002171> <http://purl.obolibrary.org/obo/UBERON_0001944> <http://purl.obolibrary.org/obo/UBERON_0003040>)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "MP:0009637") <http://purl.obolibrary.org/obo/UBPROP_0000001> <http://purl.obolibrary.org/obo/UBERON_0001944> "A narrow, transversely oriented rostral zone of the mesencephalic tectum, bounded caudally by the superior colliculus, rostrally by the habenular trigone, and laterally by the pulvinar thalami; the pretectal area contains several nuclei that receive fibers from the optic tract; it has bilateral efferent connections with the Edinger-Westphal nucleus of the oculomotor nuclear complex by way of which it mediates the pupillary light refle[MP:0009637]x")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "NLX:59721") <http://purl.obolibrary.org/obo/UBPROP_0000001> <http://purl.obolibrary.org/obo/UBERON_0001944> "Region of brain lying between the midbrain tectum and the thalamus (Sefton and Dreher, in Paxinos, G The rat central nervous system, 1995, pg 859), Situated at the level of poterior commissure and just rostral to the superior colliculus (Brodal, Neurological Anatomy, 3rd ed, 1981, pg 542)")
AnnotationAssertion(<http://purl.obolibrary.org/obo/UBPROP_0000008> <http://purl.obolibrary.org/obo/UBERON_0001944> "in monotremes, undifferentiated and possesses only a single nucleus[ISBN:0471888893]")
AnnotationAssertion(<http://purl.obolibrary.org/obo/UBPROP_0000008> <http://purl.obolibrary.org/obo/UBERON_0001944> "teleost fishes exhibit hypertrophy of the pretectum[ISBN:0471888893]")
AnnotationAssertion(<http://purl.obolibrary.org/obo/UBPROP_0000008> <http://purl.obolibrary.org/obo/UBERON_0001944> "within the amniotes, this region is smaller in mammals[ISBN:0471888893]")
AnnotationAssertion(<http://purl.obolibrary.org/obo/UBPROP_0000009> <http://purl.obolibrary.org/obo/UBERON_0001944> "It receives binocular sensory input from retinal ganglion cells of the eyes, and is the region responsible for maintaining the pupillary light reflex")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#external_ontology> "ZFA") <http://purl.obolibrary.org/obo/UBPROP_0000012> <http://purl.obolibrary.org/obo/UBERON_0001944> "part of diencephalon in ZFA - modify to adjacent here, supported by pub. Note there is some inconsistency in resources between the region vs nuclei - sometimes they are treated equivalent, sometimes separate (e.g. MP)")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/UBERON_0001944> <https://orcid.org/0000-0002-6601-2165>)
