AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:0-397-51047-0") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "MESH:A04.411.125") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "MGI:cwg") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "MP:0002264") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0002185> "The upper conducting airways of the lung; these airways arise from the terminus of the trachea.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "Wikipedia") <http://purl.obolibrary.org/obo/RO_0002161> <http://purl.obolibrary.org/obo/UBERON_0002185> <http://purl.obolibrary.org/obo/NCBITaxon_8507>)
