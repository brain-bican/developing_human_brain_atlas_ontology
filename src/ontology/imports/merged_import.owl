AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "AAO:0000225") <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/UBERON_0010272> "hyobranchial apparatus")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "AAO:0000225") <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/UBERON_0010272> "hyolingual system")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/UBERON_0010272> "UBERON:0010272")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UBERON_0010272> "hyoid apparatus")
SubClassOf(<http://purl.obolibrary.org/obo/UBERON_0010272> <http://purl.obolibrary.org/obo/UBERON_0000075>)
SubClassOf(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "AAO") <http://purl.obolibrary.org/obo/UBERON_0010272> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/UBERON_0005884>))

