AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/UBERON_0009834> "UBERON:0009834")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UBERON_0009834> "dorsolateral prefrontal cortex")
