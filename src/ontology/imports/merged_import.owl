# Class: <http://purl.obolibrary.org/obo/UBERON_0002613> (cerebellum globose nucleus)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "MP:0009982") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0002613> "The two or three small masses of gray matter that is located medial to the emboliform nucleus and lateral to the fastigial nucleus; it receives axons from the intermediate area of the cerebellar hemispheres and its afferents exit through the superior cerebellar peduncle.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "BIRNLEX:1158") <http://purl.obolibrary.org/obo/UBPROP_0000001> <http://purl.obolibrary.org/obo/UBERON_0002613> "One of two nuclei comprising the interpositus cerebellar nuclear complex of the deep cerebellar nuclei.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "Wikipedia:Globose_nucleus") <http://purl.obolibrary.org/obo/UBPROP_0000001> <http://purl.obolibrary.org/obo/UBERON_0002613> "The globose nucleus is one of the deep cerebellar nuclei. It is located medial to the emboliform nucleus and lateral to the fastigial nucleus. This nucleus contains primarily large and small multipolar neurons. The globose nucleus and emboliform nucleus are occasionally referred to collectively as the interposed nucleus. [WP,unvetted][Wikipedia:Globose_nucleus].")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "NIF") <http://purl.obolibrary.org/obo/UBPROP_0000008> <http://purl.obolibrary.org/obo/UBERON_0002613> "It is recognized in human cerebellum but is not distinguishable in all mammalian species")
