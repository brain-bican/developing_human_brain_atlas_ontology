# Class: <http://purl.obolibrary.org/obo/UBERON_0003089> (sclerotome)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Wikipedia:Sclerotome") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "XB:curator") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://github.com/obophenotype/uberon/issues/316") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0003089> "Ventral somitic compartment that is a precursor of the axial skeleton[XAO]. Sclerotomes eventually differentiate into the vertebrae and most of the skull. The caudal (posterior) half of one sclerotome fuses with the rostral (anterior) half of the adjacent one to form each vertebra. From their initial location within the somite, the sclerotome cells migrate medially towards the notochord. These cells meet the sclerotome cells from the other side to form the vertebral body. From this vertebral body, sclerotome cells move dorsally and surround the developing spinal cord, forming the vertebral arch[WP].")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#date_retrieved> "2012-06-20") Annotation(<http://www.geneontology.org/formats/oboInOwl#external_class> "AAO:0010571") Annotation(<http://www.geneontology.org/formats/oboInOwl#ontology> "AAO") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "AAO:EJS") <http://purl.obolibrary.org/obo/UBPROP_0000001> <http://purl.obolibrary.org/obo/UBERON_0003089> "Skeletogenic portion of somites.[AAO]")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#date_retrieved> "2012-09-17") Annotation(<http://www.geneontology.org/formats/oboInOwl#external_class> "VHOG:0000680") Annotation(<http://www.geneontology.org/formats/oboInOwl#ontology> "VHOG") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "DOI:10.1073/pnas.97.9.4449 Shimeld SM and Holland PW. Vertebrate innovations. PNAS (2000)") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "http://bgee.unil.ch/") <http://purl.obolibrary.org/obo/UBPROP_0000003> <http://purl.obolibrary.org/obo/UBERON_0003089> "The vertebrate sclerotome has no equivalent in amphioxus and is a novelty linked with the evolution of the axial skeleton.[well established][VHOG]")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#external_ontology> "XAO") <http://purl.obolibrary.org/obo/UBPROP_0000012> <http://purl.obolibrary.org/obo/UBERON_0003089> "part_of somite in XAO")
