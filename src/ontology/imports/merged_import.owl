AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "MP:0013530") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28722897") <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/UBERON_0003055> "epitrichium")
