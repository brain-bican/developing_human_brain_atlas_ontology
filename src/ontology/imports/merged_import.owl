AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Wikipedia:Hippocampal_sulcus") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0002899> "The hippocampal sulcus, also known as the hippocampal fissure, is a sulcus that separates the dentate gyrus from the subiculum and the CA1 field in the hippocampus. [WP,unvetted].")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#external_ontology> "ncit") <http://purl.obolibrary.org/obo/UBPROP_0000012> <http://purl.obolibrary.org/obo/UBERON_0002899> "two classes in ncit (in general ncit distinguishes between fissure and sulcus, whereas FMA treats these as exact synonyms)")
