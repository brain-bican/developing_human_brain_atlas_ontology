# Class: <http://purl.obolibrary.org/obo/UBERON_0010498> (pseudostratified columnar epithelium)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Wikipedia:Pseudostratified_columnar_epithelium") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://medical-dictionary.thefreedictionary.com/pseudostratified+epithelium") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0010498> "A simple columnar epithelium that looks stratified but is not, because its cells are arranged with their nuclei at different levels.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/UBPROP_0000009> <http://purl.obolibrary.org/obo/UBERON_0010498> "Pseudostratified epithelia function in secretion or absorption. If a specimen looks stratified but has cilia, then it is a pseudostratified ciliated epithelium, since stratified epithelia do not have cilia.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#external_ontology> "NCIT") <http://purl.obolibrary.org/obo/UBPROP_0000012> <http://purl.obolibrary.org/obo/UBERON_0010498> "glandular in NCIT; we consider the two NCIT terms synonymous")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0010498> "FMA:45572")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0010498> "NCIT:C33419")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0010498> "NCIT:C49316")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "ncithesaurus:Pseudostratified_Columnar_Epithelium") <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0010498> "UMLS:C0836138")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "ncithesaurus:Pseudostratified_Epithelium") <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0010498> "UMLS:C1514590")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0010498> "Wikipedia:Pseudostratified_columnar_epithelium")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/UBERON_0010498> "UBERON:0010498")
