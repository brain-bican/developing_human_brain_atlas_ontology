AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://periowiki.wikispot.org/Taste_bud_histology") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0001727> "A specialized receptor organ that is a collection of cells spanning the gustatory epithelium.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "http://periowiki.wikispot.org/Taste_bud_histology") <http://purl.obolibrary.org/obo/RO_0002171> <http://purl.obolibrary.org/obo/UBERON_0001727> <http://purl.obolibrary.org/obo/UBERON_0002467>)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#date_retrieved> "2012-06-20") Annotation(<http://www.geneontology.org/formats/oboInOwl#external_class> "AAO:0010573") Annotation(<http://www.geneontology.org/formats/oboInOwl#ontology> "AAO") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "AAO:EJS") <http://purl.obolibrary.org/obo/UBPROP_0000001> <http://purl.obolibrary.org/obo/UBERON_0001727> "A chemoreceptive organ.[AAO]")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#date_retrieved> "2012-09-17") Annotation(<http://www.geneontology.org/formats/oboInOwl#external_class> "VHOG:0000130") Annotation(<http://www.geneontology.org/formats/oboInOwl#ontology> "VHOG") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "http://bgee.unil.ch/") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "http://medical-dictionary.thefreedictionary.com/taste+bud") <http://purl.obolibrary.org/obo/UBPROP_0000001> <http://purl.obolibrary.org/obo/UBERON_0001727> "One of a number of receptor cell nests located in the epithelium of the papillae of the tongue and in the soft palate, epiglottis, and pharynx that mediate the sense of taste. [TFD][VHOG]")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#date_retrieved> "2012-09-17") Annotation(<http://www.geneontology.org/formats/oboInOwl#external_class> "VHOG:0000130") Annotation(<http://www.geneontology.org/formats/oboInOwl#ontology> "VHOG") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "DOI:10.1046/j.1469-7580.2001.19910133.x Graham A. The development and evolution of the pharyngeal arches. J Anat (2001)") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "http://bgee.unil.ch/") <http://purl.obolibrary.org/obo/UBPROP_0000003> <http://purl.obolibrary.org/obo/UBERON_0001727> "Experients in amphibia have shown that an intrinsic feature of the pharyngeal endoderm is its ability to generate taste buds and this capacity must have been acquired by the endoderm at the origin of the vertebrates.[well established][VHOG]")
AnnotationAssertion(<http://purl.obolibrary.org/obo/UBPROP_0000008> <http://purl.obolibrary.org/obo/UBERON_0001727> "In humans, saste buds may be found on the tongue, soft palatte, epiglottis and upper pharynx. In other species they may be found in more unusual places, such as the trunk, or on the barbels or fins of fish.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/UBPROP_0000011> <http://purl.obolibrary.org/obo/UBERON_0001727> "arise by inductive interactions between epithelial cells and invading gustatory cells from chorda tympani (facial), glossophrayngeal and vagues nerves ISBN:1607950324 (todo - request cell terms from CL)")
