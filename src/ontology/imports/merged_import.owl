SubClassOf(<http://purl.obolibrary.org/obo/UBERON_0002310> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/UBERON_0011299>))

