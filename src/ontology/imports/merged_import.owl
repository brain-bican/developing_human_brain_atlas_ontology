# Class: <http://purl.obolibrary.org/obo/UBERON_0002396> (vomer)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:0-683-40008-8") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "MP:0000098") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0002396> "The triangular flat bone of the nasal septum.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#date_retrieved> "2012-08-14") Annotation(<http://www.geneontology.org/formats/oboInOwl#external_class> "TAO:0000308") Annotation(<http://www.geneontology.org/formats/oboInOwl#ontology> "TAO") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "ZFIN:curator") <http://purl.obolibrary.org/obo/UBPROP_0000001> <http://purl.obolibrary.org/obo/UBERON_0002396> "Dermal bone that underlies the mesethmoid and inserts in a fossa on the anteroventral surface of the parasphenoid.[TAO]")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#date_retrieved> "2012-06-20") Annotation(<http://www.geneontology.org/formats/oboInOwl#external_class> "AAO:0000633") Annotation(<http://www.geneontology.org/formats/oboInOwl#ontology> "AAO") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "AAO:LAP") <http://purl.obolibrary.org/obo/UBPROP_0000001> <http://purl.obolibrary.org/obo/UBERON_0002396> "Paired, palatal bones of intramembranous origin that lie ventral to the olfactory region and help to floor the nasal capsules.[AAO]")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#date_retrieved> "2012-08-14") Annotation(<http://www.geneontology.org/formats/oboInOwl#external_class> "TAO:0000308") Annotation(<http://www.geneontology.org/formats/oboInOwl#ontology> "TAO") <http://purl.obolibrary.org/obo/UBPROP_0000002> <http://purl.obolibrary.org/obo/UBERON_0002396> "relationship loss: overlaps autopalatine-vomer joint (TAO:0001784)[TAO]")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#date_retrieved> "2012-08-14") Annotation(<http://www.geneontology.org/formats/oboInOwl#external_class> "TAO:0000308") Annotation(<http://www.geneontology.org/formats/oboInOwl#ontology> "TAO") <http://purl.obolibrary.org/obo/UBPROP_0000002> <http://purl.obolibrary.org/obo/UBERON_0002396> "relationship loss: overlaps mesethmoid-vomer joint (TAO:0001680)[TAO]")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "Wikipedia:Vomer#In_other_animals") <http://purl.obolibrary.org/obo/UBPROP_0000003> <http://purl.obolibrary.org/obo/UBERON_0002396> "In bony fish, the vomers are flattened, paired, bones forming the anterior part of the roof of the mouth, just behind the premaxillary bones. In many species, they have teeth, supplementing those in the jaw proper; in some extinct species the teeth on the vomers were actually larger than the primary set. In amphibians and reptiles, the vomers become narrower, due to the presence of the enlarged choanae (the inner part of the nostrils) on either side, and they may extend further back in the jaw. They are typically small in birds, where they form the upper hind part of the beak, again being located between the choanae. In mammals, the vomers have become narrower still, and are fused into a single, vertically oriented bone. The development of the hard palate beneath the vomer means that the bone is now located in a nasal chamber, separate from the mouth[WP]")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#date_retrieved> "2012-09-06") Annotation(<http://www.geneontology.org/formats/oboInOwl#external_class> "TAO:0000308") Annotation(<http://www.geneontology.org/formats/oboInOwl#ontology> "TAO") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "Curator") <http://purl.obolibrary.org/obo/UBPROP_0000005> <http://purl.obolibrary.org/obo/UBERON_0002396> "The vomer is paired in some taxa (e.g., Amia) while unpaired in others (e.g., teleosts).[TAO]")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0002396> "AAO:0000633")
