# Class: <http://purl.obolibrary.org/obo/UBERON_0001970> (bile)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "DOI:10.1002/cphy.c120027") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Wikipedia:Bile") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0001970> "Vital aqueous secretion of the liver that is formed by hepatocytes and modified down stream by absorptive and secretory properties of the bile duct epithelium.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/UBPROP_0000008> <http://purl.obolibrary.org/obo/UBERON_0001970> "In many species, bile is stored in the gallbladder and upon eating is discharged into the duodenum.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/UBPROP_0000009> <http://purl.obolibrary.org/obo/UBERON_0001970> "aids the process of digestion of lipids in the small intestine")
AnnotationAssertion(<http://purl.obolibrary.org/obo/UBPROP_0000009> <http://purl.obolibrary.org/obo/UBERON_0001970> "bile salts function to emulsify dietary fats and facilitate their intestinal absorption")
AnnotationAssertion(<http://purl.obolibrary.org/obo/UBPROP_0000009> <http://purl.obolibrary.org/obo/UBERON_0001970> "elimination of cholesterol")
AnnotationAssertion(<http://purl.obolibrary.org/obo/UBPROP_0000009> <http://purl.obolibrary.org/obo/UBERON_0001970> "major excretory route for potentially harmful exogenous lipophilic substances")
AnnotationAssertion(<http://purl.obolibrary.org/obo/UBPROP_0000009> <http://purl.obolibrary.org/obo/UBERON_0001970> "many hormones and pheromones are excreted in bile, and contribute to growth and development of the intestine in some species and provide attractants for the weaning of non-human vertebrates")
AnnotationAssertion(<http://purl.obolibrary.org/obo/UBPROP_0000009> <http://purl.obolibrary.org/obo/UBERON_0001970> "protects the organism from enteric infections by excreting immune globulin A (IgA), inflammatory cytokines, and stimulating the innate immune system in the intestine")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0001970> "BTO:0000121")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0001970> "CALOHA:TS-1172")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0001970> "ENVO:02000023")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0001970> "FMA:62971")
