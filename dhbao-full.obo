property_value: UBPROP:0000001 "Part of the telencephalon comprised of anterior outgrowths of either of the cerebral hemispheres in which the olfactory nerve exits.[AAO]" xsd:string {date_retrieved="2012-06-20", external_class="AAO:0010165", ontology="AAO", source="AAO:BJB"}
