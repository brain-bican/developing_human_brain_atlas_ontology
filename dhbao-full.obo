property_value: UBPROP:0000001 "An anatomical system consisting of the alimentary canal and digestive glands responsible for intake, absorption, digestion and excretion of food.[AAO]" xsd:string {date_retrieved="2012-06-20", external_class="AAO:0000129", ontology="AAO", source="AAO:BJB"}
