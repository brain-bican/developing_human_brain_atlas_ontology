property_value: http://xmlns.com/foaf/0.1/depiction "http://upload.wikimedia.org/wikipedia/commons/f/fa/Foramenjugulare.PNG" xsd:anyURI
property_value: prefLabel "jugular foramen" xsd:string
property_value: UBPROP:0000001 "Large foramen that houses the glossopharyngeal and vagus nerves and is located inside the condyloid fossa.[AAO]" xsd:string {date_retrieved="2012-06-20", external_class="AAO:0000249", ontology="AAO", source="AAO:LAP"}
property_value: UBPROP:0000001 "One of a pair of openings between the lateral part of the occipital bone and the petrous part of the temporal bones in the skull. The foramen contains the inferior petrosal sinus; the transverse sinus; some meningeal branches of the occipital and ascending pharyngeal arteries; and the glossopharyngeal, vagus, and accessory nerves. [Free_Online_Medical_Dictionary]" xsd:string {date_retrieved="2012-09-17", external_class="VHOG:0001113", ontology="VHOG", source="http://bgee.unil.ch/", source="http://medical-dictionary.thefreedictionary.com/jugular+foramen"}
property_value: UBPROP:0000002 "relationship loss: subclass braincase and otic capsule opening (AAO:0000051)[AAO]" xsd:string {date_retrieved="2012-06-20", external_class="AAO:0000249", ontology="AAO"}

