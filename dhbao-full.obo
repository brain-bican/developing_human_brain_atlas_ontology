relationship: BFO:0000050 UBERON:0016525 ! frontal lobe
property_value: http://xmlns.com/foaf/0.1/depiction "http://upload.wikimedia.org/wikipedia/commons/b/b1/Human_brainstem_anterior_view_2_description.JPG" xsd:anyURI
property_value: prefLabel "orbital gyrus" xsd:string

