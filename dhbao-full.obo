property_value: prefLabel "cardiac neural crest" xsd:string
property_value: UBPROP:0000001 "A subpopulation of the cephalic neural crest that emerges from the otic level to the anterior limit of somite 4. It migrates to the heart and is essential for the septation of the outflow track[DOI:10.1242/dev.091751]." xsd:string {source="DOI:10.1242/dev.091751"}
