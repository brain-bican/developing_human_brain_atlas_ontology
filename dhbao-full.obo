[Term]
id: UBERON:0005725
name: olfactory system
def: "A sensory system that is capable of olfaction (the sensory perception of smell)." [http://orcid.org/0000-0002-6601-2165]
subset: efo_slim
subset: pheno_slim
subset: vertebrate_core
xref: AAO:0000334
xref: AAO:0000978
xref: BILA:0000144
xref: EFO:0001973
