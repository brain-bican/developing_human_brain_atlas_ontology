        <oboInOwl:hasRelatedSynonym>ventral trigeminal tract</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ventral trigeminothalamic tract</oboInOwl:hasRelatedSynonym>
