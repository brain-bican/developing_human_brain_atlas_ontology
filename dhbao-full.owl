        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0015212"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BSPO_0000126"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005061"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>One of the two elevated edges of the neural groove[GO,MP].</obo:IAO_0000115>
        <obo:UBPROP_0000001>In front of the primitive streak two longitudinal ridges, caused by a folding up of the ectoderm, make their appearance, one on either side of the middle line. These are named the neural folds; they commence some little distance behind the anterior end of the embryonic disk, where they are continuous with each other, and from there gradually extend backward, one on either side of the anterior end of the primitive streak. Also, after differentiation it turns into the neural tubes[Wikipedia:Neural_fold].</obo:UBPROP_0000001>
        <oboInOwl:hasDbXref>EHDAA2:0001249</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:295618</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C34223</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:361461009</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0814993</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Neural_fold</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:0004087</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>neuronames:1364</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>medullary fold</oboInOwl:hasExactSynonym>
        <oboInOwl:id>UBERON:0005062</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#pheno_slim"/>
        <rdfs:label>neural fold</rdfs:label>
        <skos:prefLabel>neural fold</skos:prefLabel>
    </owl:Class>
