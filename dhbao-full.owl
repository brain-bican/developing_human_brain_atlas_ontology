        <oboInOwl:hasExactSynonym>spinal cord meninx</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>spinal meninges</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>spinal meninx</oboInOwl:hasExactSynonym>
