        <oboInOwl:hasDbXref>MESH:D065820</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:369186007</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Zona_incerta</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>neuronames:438</oboInOwl:hasDbXref>
