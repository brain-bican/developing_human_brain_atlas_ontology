        <oboInOwl:hasRelatedSynonym>decussatio lemniscorum medialium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>decussatio sensoria</oboInOwl:hasRelatedSynonym>
