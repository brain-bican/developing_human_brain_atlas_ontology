            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A tubular passage that extends from the primitive pit into the head process during the early stages of embryonic development in mammals. It perforates the splanchnopleure layer so that the yolk sac and the amnion are connected temporarily.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>FMA:293127</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C34230</oboInOwl:hasDbXref>
