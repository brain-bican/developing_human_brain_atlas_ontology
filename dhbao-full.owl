        <oboInOwl:hasRelatedSynonym>fibre arciformes olivares</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>fibre arciformes sensibiles</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0006087</oboInOwl:id>
        <rdfs:label>internal arcuate fiber bundle</rdfs:label>
        <skos:prefLabel>internal arcuate fiber bundle</skos:prefLabel>
