    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001213"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The tiny hair-like projections that protrude from the inside of the small intestine that contain blood vessels that capture digested nutrients that are absorbed through the intestinal wall; the villi increase the absorptive surface area of the small intestine by approximately 30-fold.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>MGI:csmith</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MGI:rbabiuk</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MP:0008108</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001213"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000001"/>
        <owl:annotatedTarget>The entire digestive tract is lined by well developed villi, which are longest in the intestinal bulb and decrease progressively in size towards the caudal end of the intestine. No crypts are present, but, the regions between the villi, the intervillus pockets, have a crypt-like function. Cells are produced in the intervillus pockets and shed from the villus tips. Crosnier et al. 2005[TAO]</owl:annotatedTarget>
        <oboInOwl:date_retrieved>2012-08-14</oboInOwl:date_retrieved>
        <oboInOwl:external_class>TAO:0005125</oboInOwl:external_class>
        <oboInOwl:ontology>TAO</oboInOwl:ontology>
        <oboInOwl:source>ZFIN:curator</oboInOwl:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001213"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000012"/>
        <owl:annotatedTarget>the BTO class refers to a generic villous</owl:annotatedTarget>
        <oboInOwl:external_ontology>BTO</oboInOwl:external_ontology>
    </owl:Axiom>
