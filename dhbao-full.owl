    <!-- http://purl.obolibrary.org/obo/UBERON_0022256 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0022256">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005838"/>
        <rdfs:subClassOf rdf:nodeID="genid30758"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002176"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001875"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002176"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001906"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The subthalamic fasciculus is a tract which connects the subthalamic nucleus and the globus pallidus. It is a bidirectional connection between the GP and the subthalamic nucleus, including (1) fibers running from the GPe to the subthalamic nucleus, and (2) fibers running from the STN back to the GP.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>DHBA:12089</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:77525</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>HBA:265505350</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MBA:317</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:369187003</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Subthalamic_fasciculus</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>neuronames:2280</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>fasciculus subthalamicus</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>subthalamic fascicle</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>subthalamic fasciculus</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0022256</oboInOwl:id>
        <rdfs:label>subthalamic fasciculus</rdfs:label>
        <skos:prefLabel>subthalamic fasciculus</skos:prefLabel>
    </owl:Class>
