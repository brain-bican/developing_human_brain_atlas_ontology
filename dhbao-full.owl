        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005293"/>
        <rdfs:subClassOf rdf:nodeID="genid13701"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002433"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002129"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The flocculonodular lobe is a lobe of the cerebellum consisting of the nodule and the flocculus. It is closely associated with the vestibulocerebellum. [WP,unvetted].</obo:IAO_0000115>
        <obo:RO_0002171 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002131"/>
        <obo:RO_0002171 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004002"/>
        <obo:UBPROP_0000009>receives input from the inferior and medial vestibular nuclei and sends fibers back to the vestibular nuclei, and processes and integrates these signals to allow for the constant maintenance of balance [MP:0009961]</obo:UBPROP_0000009>
        <oboInOwl:hasDbXref>BAMS:FNL</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BIRNLEX:904</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>DHBA:12852</oboInOwl:hasDbXref>
