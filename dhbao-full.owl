        <oboInOwl:hasDbXref>neuronames:795</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>arcuate fibers medial lemniscus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>fibrae arcuatae internae</oboInOwl:hasExactSynonym>
