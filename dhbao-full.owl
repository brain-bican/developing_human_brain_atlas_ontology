    <!-- http://purl.obolibrary.org/obo/UBERON_0004922 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0004922">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0011215"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0022303"/>
        <rdfs:subClassOf rdf:nodeID="genid20334"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0009953"/>
            </owl:Restriction>
        </rdfs:subClassOf>
