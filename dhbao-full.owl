        <oboInOwl:hasExactSynonym>optic nerve (generic)</oboInOwl:hasExactSynonym>
        <oboInOwl:id>UBERON:0004904</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#grouping_class"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#pheno_slim"/>
        <rdfs:comment>for the vertebrate-specific structure, see UBERON:0000941 (cranial nerve II)</rdfs:comment>
        <rdfs:label>neuron projection bundle connecting eye with brain</rdfs:label>
        <skos:prefLabel>neuron projection bundle connecting eye with brain</skos:prefLabel>
