        <oboInOwl:hasDbXref>EV:0100184</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:77616</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GAID:667</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D003342</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C12448</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:279318005</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0010097</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0001175</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Corpus_striatum</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>neuronames:2339</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>striate body</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>striated body</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0000369</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#efo_slim"/>
        <rdfs:comment>* According to the 1917 version of Gray&apos;s Anatomy, it is the combination of the lentiform nucleus (also known as the lenticular nucleus) and the caudate nucleus * According to BrainInfo it is a part of the basal ganglia comprising the globus pallidus and striatum</rdfs:comment>
        <rdfs:label>corpus striatum</rdfs:label>
        <skos:prefLabel>corpus striatum</skos:prefLabel>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/b/b3/Gray656.png</foaf:depiction>
    </owl:Class>
