        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#uberon_slim"/>
        <rdfs:label>intralaminar nuclear group</rdfs:label>
        <skos:prefLabel>intralaminar nuclear group</skos:prefLabel>
