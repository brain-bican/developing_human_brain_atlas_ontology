        <oboInOwl:hasRelatedSynonym>cortical mantle layer</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0004040</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#pheno_slim"/>
        <rdfs:label>cortical intermediate zone</rdfs:label>
        <skos:prefLabel>cortical intermediate zone</skos:prefLabel>
