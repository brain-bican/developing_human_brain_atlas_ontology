    <!-- http://purl.obolibrary.org/obo/UBERON_0002913 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002913">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0035927"/>
        <obo:IAO_0000115>The intraparietal sulcus (IPS) is located on the lateral surface of the parietal lobe, and consists of an oblique and a horizontal portion. The IPS contains a series of functionally distinct subregions that have been intensively investigated using both single cell neurophysiology in primates and human functional neuroimaging. Its principal functions are related to perceptual-motor coordination (for directing eye movements and reaching) and visual attention. The IPS is also thought to play a role in other functions, including processing symbolic numerical information, visuospatial working memory and interpreting the intent of others. [WP,unvetted].</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym>ITPS</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>BAMS:ips</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BAMS:itps</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BIRNLEX:4031</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BM:Tel-Cx-IPS</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BTO:0003787</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>DHBA:10620</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:83772</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>HBA:9372</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C32879</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:279338006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0228213</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C1281069</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Intraparietal_sulcus</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>neuronames:97</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>interparietal fissure</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>intraparietal fissure</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>sulcus interparietalis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>Turner sulcus</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>intraparietal sulcus of Turner</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>sulcus intraparietalis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0002913</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#uberon_slim"/>
        <rdfs:label>intraparietal sulcus</rdfs:label>
        <skos:prefLabel>intraparietal sulcus</skos:prefLabel>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/2/2a/Gray726_intraparietal_sulcus.svg</foaf:depiction>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002913"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The intraparietal sulcus (IPS) is located on the lateral surface of the parietal lobe, and consists of an oblique and a horizontal portion. The IPS contains a series of functionally distinct subregions that have been intensively investigated using both single cell neurophysiology in primates and human functional neuroimaging. Its principal functions are related to perceptual-motor coordination (for directing eye movements and reaching) and visual attention. The IPS is also thought to play a role in other functions, including processing symbolic numerical information, visuospatial working memory and interpreting the intent of others. [WP,unvetted].</owl:annotatedTarget>
