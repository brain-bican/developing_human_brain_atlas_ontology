    <!-- http://purl.obolibrary.org/obo/UBERON_0002019 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002019">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
