        <oboInOwl:hasDbXref>neuronames:171</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>precommissural hippocampus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>subcallosal gyrus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>gyrus paraterminalis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>gyrus subcallosus</oboInOwl:hasRelatedSynonym>
