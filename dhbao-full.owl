        <owl:annotatedTarget>trabeculae</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003004"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0000446 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0000446">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005401"/>
        <obo:IAO_0000115>Gray matter structure located on the midline of the forebrain consisting of the septum pellucidum (in some species) and the septal nuclei (Heimer, 1996).</obo:IAO_0000115>
        <obo:UBPROP_0000001>Subdivision of the telencephalon on the midline between the lateral ventricles which contains the septum pellucidum and the septal nuclei[FMA][FMA:61842].</obo:UBPROP_0000001>
        <oboInOwl:hasBroadSynonym>Se</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>septum</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>BAMS:SA</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BAMS:SEP</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BAMS:Sep</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BAMS:Spt</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BIRNLEX:963</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BM:Tel-Spt</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BTO:0002705</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EMAPA:32837</oboInOwl:hasDbXref>
