        <oboInOwl:external_ontology>EHDAA2</oboInOwl:external_ontology>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004161"/>
