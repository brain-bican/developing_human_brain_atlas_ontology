            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005805"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:UBPROP_0000003>A study of embryos shows that in all vertebrates six arterial arches link the ventral aorta with a pair of lateral dorsal aortae on each side of the body. The latter unite posteriorly to form a single median dorsal aorta wich takes blood to the body.[well established][VHOG]</obo:UBPROP_0000003>
        <obo:UBPROP_0000008>Contributes to the arch of aorta in humans</obo:UBPROP_0000008>
        <oboInOwl:hasDbXref>EHDAA2:0000936</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EHDAA:404</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EMAPA:16205</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0000478</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:361403005</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0000484</oboInOwl:hasDbXref>
        <oboInOwl:id>UBERON:0005613</oboInOwl:id>
        <rdfs:label>left dorsal aorta</rdfs:label>
        <skos:prefLabel>left dorsal aorta</skos:prefLabel>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005613"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000003"/>
        <owl:annotatedTarget>A study of embryos shows that in all vertebrates six arterial arches link the ventral aorta with a pair of lateral dorsal aortae on each side of the body. The latter unite posteriorly to form a single median dorsal aorta wich takes blood to the body.[well established][VHOG]</owl:annotatedTarget>
        <oboInOwl:date_retrieved>2012-09-17</oboInOwl:date_retrieved>
