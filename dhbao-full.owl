        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001900"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0009641"/>
