        <oboInOwl:hasDbXref>SCTID:136854008</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Frontal_suture</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>frontal suture of skull</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>median frontal suture</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>sutura frontalis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>sutura metopica</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>metopic suture</oboInOwl:hasRelatedSynonym>
