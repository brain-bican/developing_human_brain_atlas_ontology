        <oboInOwl:hasExactSynonym>gonad vein</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>gonada vein</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>vein of gonad</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>vein of gonada</oboInOwl:hasExactSynonym>
        <oboInOwl:id>UBERON:0003848</oboInOwl:id>
