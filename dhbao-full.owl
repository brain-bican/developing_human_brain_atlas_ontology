    <!-- http://purl.obolibrary.org/obo/UBERON_0002162 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002162">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0010135"/>
