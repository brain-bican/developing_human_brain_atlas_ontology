    <!-- http://purl.obolibrary.org/obo/UBERON_0005171 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0005171">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002394"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002176"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001174"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002176"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002107"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Any portion of the ducts that carry bile from the liver to the common bile duct. This may include both intrahapetic components (parts of left and right hepatic ducts) and extrahapetic components (common hepatic duct, plus hilar portion).</obo:IAO_0000115>
        <obo:IAO_0000116>TODO - MA distinguishes between bile duct, hepatic duct, common bile duct and common hepatic duct. in FMA hepatic duct and common hepatic duct are the same</obo:IAO_0000116>
        <obo:UBPROP_0000001>A duct that carries bile from the liver to the small intestine.[TAO]</obo:UBPROP_0000001>
        <obo:UBPROP_0000001>The excretory duct of the liver or one of its branches in the lobes of the liver. [TFD][VHOG]</obo:UBPROP_0000001>
        <obo:UBPROP_0000001>The hepatic duct is the duct that leads from the liver to the bile duct[GO].</obo:UBPROP_0000001>
        <oboInOwl:hasDbXref>EHDAA2:0000741</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EHDAA:3049</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EMAPA:16843</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:71891</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0000357</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C32730</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:245399002</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0917710</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0000219</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>galen:HepaticDuct</oboInOwl:hasDbXref>
        <oboInOwl:id>UBERON:0005171</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#pheno_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#vertebrate_core"/>
        <rdfs:label>hepatic duct</rdfs:label>
        <skos:prefLabel>hepatic duct</skos:prefLabel>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005171"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Any portion of the ducts that carry bile from the liver to the common bile duct. This may include both intrahapetic components (parts of left and right hepatic ducts) and extrahapetic components (common hepatic duct, plus hilar portion).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>http://orcid.org/0000-0002-6601-2165</oboInOwl:hasDbXref>
    </owl:Axiom>
