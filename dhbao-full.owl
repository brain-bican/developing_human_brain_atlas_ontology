        <oboInOwl:hasExactSynonym>external medulary lamina of lentiform nucleus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>external medullary lamina of corpus striatum</oboInOwl:hasExactSynonym>
