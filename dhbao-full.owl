        <oboInOwl:hasDbXref>Wikipedia:Exocrine_gland</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>ducted gland</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>glandula exocrina</oboInOwl:hasExactSynonym>
