        <skos:prefLabel>aortico-pulmonary spiral septum</skos:prefLabel>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/b/b9/Gray470.png</foaf:depiction>
    </owl:Class>
