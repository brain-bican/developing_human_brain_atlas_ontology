        <owl:annotatedTarget rdf:resource="http://purl.obolibrary.org/obo/UBERON_0011814"/>
        <oboInOwl:source>NCBIBook:NBK53175</oboInOwl:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0009122"/>
