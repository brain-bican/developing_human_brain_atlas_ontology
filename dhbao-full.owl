        <oboInOwl:hasDbXref>XAO:0000186</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>neuronames:1571</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>ocular ciliary body</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>anterior uvea</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ciliary bodies</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>corpus ciliare</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0001775</oboInOwl:id>
