        <oboInOwl:hasDbXref>TAO:0001501</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0007301</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0001207</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VSAO:0000040</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Cartilage</oboInOwl:hasDbXref>
