    <!-- http://purl.obolibrary.org/obo/UBERON_0002336 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002336">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002473"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005340"/>
