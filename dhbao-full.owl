        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A Z-shaped canal running through the temporal bone from the internal acoustic meatus to the stylomastoid foramen. It is located within the middle ear region, according to its shape it is divided into three main segments: the labyrinthine, the tympanic, and the mastoidal segment .</owl:annotatedTarget>
        <oboInOwl:hasDbXref>Wikipedia:Facial_canal</oboInOwl:hasDbXref>
    </owl:Axiom>
