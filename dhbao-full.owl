        <oboInOwl:hasDbXref>SCTID:362353000</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0228265</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C1284612</oboInOwl:hasDbXref>
