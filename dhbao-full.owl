        <oboInOwl:hasDbXref>Wikipedia:Common_carotid_artery</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>carotid artery system</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>common carotid artery</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>trunk of common carotid tree</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>a. carotis communis</oboInOwl:hasRelatedSynonym>
