        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#vertebrate_core"/>
        <rdfs:label>pericardial cavity</rdfs:label>
        <skos:prefLabel>pericardial cavity</skos:prefLabel>
    </owl:Class>
