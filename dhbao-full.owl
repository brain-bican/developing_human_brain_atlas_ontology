        <rdfs:subClassOf rdf:nodeID="genid11922"/>
        <obo:IAO_0000115>The lateral medullary lamina is a thin white structure located in the basal ganglia of the primate brain. Bounded laterally by the putamen and medially by the globus pallidus, it is defined on the basis of Nissl or myelin stain ( Carpenter-1983 ).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>BAMS:lml</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BIRNLEX:1634</oboInOwl:hasDbXref>
