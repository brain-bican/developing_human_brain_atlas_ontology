    <!-- http://purl.obolibrary.org/obo/UBERON_0010010 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0010010">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0009663"/>
        <rdfs:subClassOf rdf:nodeID="genid26388"/>
        <obo:IAO_0000115>A group of neurons in the basal forebrain that has wide projections to the neocortex and is rich in acetylcholine and choline acetyltransferase. It undergoes degeneration in paralysis agitans and Alzheimer&apos;s disease.</obo:IAO_0000115>
        <obo:UBPROP_0000009>rich in acetylcholine and choline acetyltransferase</obo:UBPROP_0000009>
        <obo:UBPROP_0000012>MA has basal nucleus as synonym for BG.</obo:UBPROP_0000012>
        <obo:UBPROP_0000015>The NBM is inferior to the globus pallidus and within an area known as the substantia innominata</obo:UBPROP_0000015>
        <oboInOwl:hasDbXref>BAMS:MA</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BAMS:MCPO</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BIRNLEX:1107</oboInOwl:hasDbXref>
