        <oboInOwl:hasDbXref>Wikipedia:Right_lobe_of_liver</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0005173</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>liver right lobe</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>lobus hepaticus dexter</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>right liver lobe</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>2nd lobe</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>gall bladder lobe</oboInOwl:hasRelatedSynonym>
