        <oboInOwl:hasDbXref>NLX:147822</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>axonal tract</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>neuraxis tract</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>tract of neuraxis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>nerve tract</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym>nerve tract</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>tract</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0001018</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#cumbo"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#pheno_slim"/>
        <rdfs:comment>WP says this is the analog of peripheral nerves in CNS.</rdfs:comment>
        <rdfs:label>axon tract</rdfs:label>
        <skos:prefLabel>axon tract</skos:prefLabel>
