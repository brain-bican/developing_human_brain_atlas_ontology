        <oboInOwl:hasExactSynonym>superior olivary nuclei</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>regio olivaris superioris</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>superior olivary nucleus</oboInOwl:hasRelatedSynonym>
