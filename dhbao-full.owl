        <oboInOwl:hasDbXref>Wikipedia:Thoracid_diaphragm</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>diaphragm muscle</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>diaphragm of thorax</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>thoracic diaphragm</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>midriff</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>phren</oboInOwl:hasRelatedSynonym>
