    <!-- http://purl.obolibrary.org/obo/UBERON_0014529 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0014529">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0022254"/>
        <obo:IAO_0000115>The lenticular fasciculus is a tract connecting the globus pallidus to the Thalamic fasciculus. The thalamic fasciculus (composed of the lenticular fasciculus and ansa lenticularis) runs into the Thalamus. It connects the globus pallidus to the thalamus.</obo:IAO_0000115>
        <obo:UBPROP_0000012>FMA appears to divide this into diencephalon and telencephalon parts</obo:UBPROP_0000012>
        <oboInOwl:hasDbXref>BAMS:lenf_(H2)</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>DHBA:10585</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:61976</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:62067</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>HBA:265505158</oboInOwl:hasDbXref>
