        <oboInOwl:hasDbXref>neuronames:2710</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>olfactory bulb main glomerulus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>stratum glomerulosum bulbi olfactorii</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>glomerular layer of the olfactory bulb</oboInOwl:hasRelatedSynonym>
