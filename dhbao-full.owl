    <!-- http://purl.obolibrary.org/obo/UBERON_0022264 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0022264">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0022260"/>
        <rdfs:subClassOf rdf:nodeID="genid30788"/>
        <obo:IAO_0000115>The optic radiation (also known as the geniculo-calcarine tract or as the geniculostriate pathway) is a collection of axons from relay neurons in the lateral geniculate nucleus of the thalamus carrying visual information to the visual cortex (also called striate cortex) along the calcarine fissure. There is one such tract on each side of the brain.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>DHBA:266441621</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:61941</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>HBA:9311</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:280953008</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Optic_radiation</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>neuronames:1440</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Gratiolet&apos;s radiation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>archambault%27s loop</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>genicula-celcarine tract</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>geniculo-calcarine tract</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>geniculocalcarine tract</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>geniculostriate pathway</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>meyer&apos;s loop</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>optic radiations</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>radiatio optica</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>railroad nystagmus</oboInOwl:hasRelatedSynonym>
