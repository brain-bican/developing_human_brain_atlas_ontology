    <!-- http://purl.obolibrary.org/obo/UBERON_0008835 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0008835">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004185"/>
