    <!-- http://purl.obolibrary.org/obo/UBERON_0003054 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0003054">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000119"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005291"/>
