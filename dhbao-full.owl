        <oboInOwl:hasDbXref>BM:CV</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>DHBA:12439</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:54621</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>HBA:9531</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MBA:101</oboInOwl:hasDbXref>
