        <oboInOwl:hasDbXref>FMA:46690</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0002307</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C52928</oboInOwl:hasDbXref>
