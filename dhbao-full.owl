    <!-- http://purl.obolibrary.org/obo/UBERON_0001943 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001943">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002616"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001891"/>
