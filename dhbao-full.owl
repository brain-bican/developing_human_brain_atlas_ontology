        <owl:annotatedTarget>mesenchyma</owl:annotatedTarget>
        <oboInOwl:hasDbXref>Wikipedia:Mesenchyme</oboInOwl:hasDbXref>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003011"/>
    </owl:Axiom>
    


