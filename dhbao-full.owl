        <oboInOwl:hasDbXref>Wikipedia:Brunner&apos;s_glands</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Brunner&apos;s gland</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>gland of Brunner</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>submucosal gland of duodenum</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>glandula duodenales</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>glandula duodenales Brunneri</oboInOwl:hasRelatedSynonym>
