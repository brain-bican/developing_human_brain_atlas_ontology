        <owl:annotatedTarget>Apical ectodermal ridge that is part of the pectoral fin bud.[TAO]</owl:annotatedTarget>
        <oboInOwl:date_retrieved>2012-08-14</oboInOwl:date_retrieved>
        <oboInOwl:external_class>TAO:0000085</oboInOwl:external_class>
        <oboInOwl:ontology>TAO</oboInOwl:ontology>
