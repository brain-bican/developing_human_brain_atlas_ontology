        <oboInOwl:hasDbXref>VHOG:0001224</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:0000021</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0001083</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>VZ</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>brain ventricular zone</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ventricular zone of brain</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>ventricular zones</oboInOwl:hasRelatedSynonym>
