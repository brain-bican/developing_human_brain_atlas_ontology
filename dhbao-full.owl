        <oboInOwl:hasDbXref>ncithesaurus:Inferior_Frontal_Gyrus</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>neuronames:85</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>inferior frontal convolution</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>gyrus F3</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>gyrus frontalis inferior</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>gyrus frontalis tertius</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>regio subfrontalis</oboInOwl:hasRelatedSynonym>
