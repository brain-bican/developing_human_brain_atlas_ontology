        <oboInOwl:hasDbXref>neuronames:2852</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>LNTB</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>lateral nucleus of the trapezoid body</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>lateral trapezoid nucleus</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0016843</oboInOwl:id>
        <rdfs:label>lateral nucleus of trapezoid body</rdfs:label>
        <skos:prefLabel>lateral nucleus of trapezoid body</skos:prefLabel>
