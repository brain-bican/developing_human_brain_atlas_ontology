    <!-- http://purl.obolibrary.org/obo/UBERON_0011158 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0011158">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000075"/>
