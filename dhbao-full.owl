        <oboInOwl:id>channels_from</oboInOwl:id>
        <rdfs:label>channels_from</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/uberon/core#channels_into -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/uberon/core#channels_into">
