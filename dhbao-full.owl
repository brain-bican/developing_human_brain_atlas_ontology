    <owl:Ontology rdf:about="https://purl.brain-bican.org/ontology/dhbao/dhbao-full.owl">
        <owl:versionIRI rdf:resource="https://purl.brain-bican.org/ontology/dhbao/releases/2026-11-05/dhbao-full.owl"/>
        <obo:IAO_0000700 rdf:resource="https://purl.brain-bican.org/ontology/dhbao/DHBA_10155"/>
        <terms:description>An application ontology built by combining ontologised versions of the Allen Institute Developing Human Brain Atlas (DHBA) StructureGraph mapped to Uberon.</terms:description>
        <terms:license rdf:resource="https://creativecommons.org/licenses/unspecified"/>
        <terms:title>Developing Human Brain Atlas Ontology</terms:title>
        <owl:versionInfo>2026-11-05</owl:versionInfo>
    </owl:Ontology>
    


