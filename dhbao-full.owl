    <!-- http://purl.obolibrary.org/obo/UBERON_0002128 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002128">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007245"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0019263"/>
        <rdfs:subClassOf rdf:nodeID="genid7576"/>
