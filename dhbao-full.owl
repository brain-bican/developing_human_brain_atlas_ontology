        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDbXref"/>
        <owl:annotatedTarget>UMLS:C0224194</owl:annotatedTarget>
        <oboInOwl:source>ncithesaurus:Genioglossus</oboInOwl:source>
    </owl:Axiom>
    


