        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#pheno_slim"/>
        <rdfs:label>pharyngeal arch mesenchymal region</rdfs:label>
        <skos:prefLabel>pharyngeal arch mesenchymal region</skos:prefLabel>
